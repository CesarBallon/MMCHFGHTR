----+  for (let i = 0; i < 20; i += 1) {
----+    attacker.timer = Math.max(0, attacker.timer - 1 / 60);
----+    context.resolveMeleeHit(attacker, defender);
----+    if (attacker.hitResolved && hitFrame === null) hitFrame = i;
