diff --git a/tests/legacy/draw-idle-bounds.test.mjs b/tests/legacy/draw-idle-bounds.test.mjs
new file mode 100644
index 0000000..9dbe2a2
--- /dev/null
+++ b/tests/legacy/draw-idle-bounds.test.mjs
@@ -0,0 +1,79 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const game = readFileSync(new URL('../../dist/game.js', import.meta.url), 'utf8');
+const drawIdleSource = game.slice(game.indexOf('  function drawIdle('), game.indexOf('  function drawIdleShadow('));
+
+function makeRecordingCtx() {
+  const state = { alpha: 1, blend: 'source-over', tx: 0, ty: 0, sx: 1 };
+  const stack = [];
+  const calls = [];
+  const ctx = {
+    setTransform() { state.tx = 0; state.ty = 0; state.sx = 1; },
+    save() { stack.push({ ...state }); },
+    restore() { Object.assign(state, stack.pop()); },
+    translate(x, y) { state.tx += x; state.ty += y; },
+    scale(sx) { state.sx *= sx; },
+    clearRect() {},
+    get globalCompositeOperation() { return state.blend; }, set globalCompositeOperation(v) { state.blend = v; },
+    get globalAlpha() { return state.alpha; }, set globalAlpha(v) { state.alpha = v; },
+    imageSmoothingEnabled: true, imageSmoothingQuality: 'high',
+    drawImage(im, sx, sy, sw, sh, dx, dy, dw, dh) {
+      const pageLeftUnscaled = state.tx + dx * state.sx;
+      const pageRightUnscaled = state.tx + (dx + dw) * state.sx;
+      const left = Math.min(pageLeftUnscaled, pageRightUnscaled), right = Math.max(pageLeftUnscaled, pageRightUnscaled);
+      const top = state.ty + dy, bottom = top + dh;
+      calls.push({ left, right, top, bottom });
+    },
+  };
+  return { ctx, calls };
+}
+
+function runDrawIdle(x, y, height, face, W, H) {
+  const { ctx: idleCtx, calls } = makeRecordingCtx();
+  let capturedClip = null;
+  const outerCtx = { drawImage(canvas, cx, cy, cw, ch) { capturedClip = { cx, cy, cw, ch }; } };
+  const fmA = { anchorX: 40, bottom: 180, sx: 0, sy: 0, sw: 120, sh: 200 };
+  const fmB = { anchorX: 55, bottom: 190, sx: 0, sy: 0, sw: 130, sh: 210 };
+  const images = { idle_test: {} };
+  const sheetMeta = { get: () => ({ maxH: 400, maxW: 300, frames: [fmA, fmB] }) };
+  const wrapped = new Function('idleCtx', 'ctx', 'W', 'H', 'images', 'sheetMeta', 'globalTime', 'idleCanvas',
+    `${drawIdleSource}\nreturn drawIdle;`);
+  const fn = wrapped(idleCtx, outerCtx, W, H, images, sheetMeta, 0, {});
+  fn({ id: 'test' }, 0, x, y, height, face, 1, Infinity, 0, false);
+  return { clip: capturedClip, calls };
+}
+
+test('the clip/clear/copy box always fully contains the actual drawn sprite, both facings, mid-screen', () => {
+  const W = 1280, H = 720;
+  for (const face of [1, -1]) {
+    const { clip, calls } = runDrawIdle(400, 600, 300, face, W, H);
+    assert.ok(clip.cw > 0 && clip.ch > 0);
+    for (const c of calls) {
+      assert.ok(c.left >= clip.cx - 0.01 && c.right <= clip.cx + clip.cw + 0.01);
+      assert.ok(c.top >= clip.cy - 0.01 && c.bottom <= clip.cy + clip.ch + 0.01);
+    }
+  }
+});
+
+test('the clip box stays within canvas bounds and still contains the visible portion near the edges', () => {
+  const W = 1280, H = 720;
+  for (const [x, y, face] of [[0, 0, 1], [W, H, -1], [50, 50, 1], [1250, 700, -1]]) {
+    const { clip, calls } = runDrawIdle(x, y, 300, face, W, H);
+    assert.ok(clip.cx >= 0 && clip.cy >= 0 && clip.cx + clip.cw <= W && clip.cy + clip.ch <= H);
+    for (const c of calls) {
+      const vl = Math.max(0, c.left), vr = Math.min(W, c.right), vt = Math.max(0, c.top), vb = Math.min(H, c.bottom);
+      if (vr <= vl || vb <= vt) continue;
+      assert.ok(vl >= clip.cx - 0.01 && vr <= clip.cx + clip.cw + 0.01);
+      assert.ok(vt >= clip.cy - 0.01 && vb <= clip.cy + clip.ch + 0.01);
+    }
+  }
+});
+
+test('the clip box is much smaller than the full canvas for a typical mid-screen draw (the actual optimization)', () => {
+  const W = 1280, H = 720;
+  const { clip } = runDrawIdle(400, 600, 300, 1, W, H);
+  const clipArea = clip.cw * clip.ch, fullArea = W * H;
+  assert.ok(clipArea < fullArea * 0.25, `expected a much smaller clip region, got ${clipArea} of ${fullArea}`);
+});
